{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Portal: Full stack",
      "configurations": [
        "Portal: API",
        "Portal: Web"
      ],
      "preLaunchTask": "debug: prepare",
      "stopAll": true,
      "presentation": {
        "order": 1
      }
    }
  ],
  "configurations": [
    {
      "name": "Portal: API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "debug: prepare",
      "program": "${workspaceFolder}/src/Portal.Api/bin/Debug/net10.0/Portal.Api.dll",
      "cwd": "${workspaceFolder}/src/Portal.Api",
      "launchSettingsProfile": "http",
      "console": "internalConsole",
      "presentation": {
        "order": 2
      }
    },
    {
      "name": "Portal: Web",
      "type": "blazorwasm",
      "request": "launch",
      "preLaunchTask": "build",
      "cwd": "${workspaceFolder}/src/Portal.Web",
      "projectPath": "${workspaceFolder}/src/Portal.Web/Portal.Web.csproj",
      "url": "http://localhost:5180",
      "browser": "chrome",
      "presentation": {
        "order": 3
      }
    }
  ]
}
