@inherits LayoutComponentBase
@implements IDisposable
@using Portal.Contracts.Auth
@inject Portal.Web.Services.AuthSession Session
@inject NavigationManager Navigation

<header>
    <nav aria-label="Hlavní navigace">
        <NavLink href="" Match="NavLinkMatch.All">Pracovní portál</NavLink>
        @if (Session.User is { } user)
        {
            @if (user.Role == UserRoles.Company)
            {
                <NavLink href="company/jobs">Správa pozic</NavLink>
                <NavLink href="company/team">HR Tým</NavLink>
                <NavLink href="company/profile">Profil firmy</NavLink>
            }

            <NavLink href="account">Můj účet</NavLink>
            <span>@user.FirstName @user.LastName</span>
            <button type="button" @onclick="Logout">Odhlásit se</button>
        }
        else
        {
            <NavLink href="login">Přihlásit se</NavLink>
            <NavLink href="register">Registrace</NavLink>
        }
    </nav>
</header>
<main>@Body</main>

@code {
    protected override void OnInitialized() => Session.Changed += OnSessionChanged;
    private void OnSessionChanged() => InvokeAsync(StateHasChanged);
    private void Logout()
    {
        Session.Logout();
        Navigation.NavigateTo("");
    }
    public void Dispose() => Session.Changed -= OnSessionChanged;
}
