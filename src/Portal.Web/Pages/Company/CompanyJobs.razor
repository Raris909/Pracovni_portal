@page "/company/jobs"
@page "/company/{CompanyId:guid}/jobs"
@using System.Net
@using Portal.Contracts.Auth
@using Portal.Contracts.Companies
@using Portal.Contracts.Jobs
@inject Portal.Web.Services.AuthSession Session
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Správa pozic</PageTitle>

<h1>Správa pracovních pozic</h1>

@if (loading)
{
    <p>Načítání…</p>
}
else if (companies is null || companies.Count == 0)
{
    <p>Nejste členem žádné firmy. Nejprve si <a href="company/profile">založte firmu</a>.</p>
}
else
{
    @if (companies.Count > 1)
    {
        <div>
            <label for="company-select">Vyberte firmu:</label>
            <select id="company-select" value="@selectedCompanyId" @onchange="OnCompanyChanged">
                @foreach (var item in companies)
                {
                    <option value="@item.Company.Id">@item.Company.Name</option>
                }
            </select>
        </div>
        <hr />
    }

    <div>
        <p><a href="@($"company/{selectedCompanyId}/jobs/new")">+ Vytvořit novou pozici</a></p>
    </div>

    @if (error is not null)
    {
        <p role="alert" style="color: red;">@error</p>
    }

    @if (jobs is null || jobs.Count == 0)
    {
        <p>Tato firma zatím nemá žádné pracovní nabídky.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Název pozice</th>
                    <th>Režim</th>
                    <th>Úvazek</th>
                    <th>Stav</th>
                    <th>Vytvořeno</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in jobs)
                {
                    <tr>
                        <td><strong>@job.Title</strong></td>
                        <td>@GetWorkModeLabel(job.WorkMode)</td>
                        <td>@GetEmploymentTypeLabel(job.EmploymentType)</td>
                        <td>@GetStatusLabel(job.Status)</td>
                        <td>@job.CreatedAt.ToString("d.M.yyyy")</td>
                        <td class="actions">
                            @if (job.Status == JobOfferStatuses.Draft)
                            {
                                <a class="btn-secondary" href="@($"company/{selectedCompanyId}/jobs/edit/{job.Id}")">Upravit</a>
                                <button type="button" disabled="@busy" @onclick="() => PublishAsync(job.Id)">Publikovat</button>
                            }
                            else if (job.Status == JobOfferStatuses.Published)
                            {
                                <button type="button" disabled="@busy" @onclick="() => CloseAsync(job.Id)">Uzavřít</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public Guid? CompanyId { get; set; }

    private List<CompanyMembershipResponse>? companies;
    private List<JobOfferManagementResponse>? jobs;
    private Guid selectedCompanyId;
    private bool loading = true;
    private bool busy;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (Session.User is null || Session.User.Role != UserRoles.Company)
        {
            Navigation.NavigateTo("login");
            return;
        }

        try
        {
            companies = await Http.GetFromJsonAsync<List<CompanyMembershipResponse>>("api/companies");
            if (companies is { Count: > 0 })
            {
                var target = CompanyId.HasValue
                    ? companies.FirstOrDefault(c => c.Company.Id == CompanyId.Value) ?? companies[0]
                    : companies[0];

                selectedCompanyId = target.Company.Id;
                await LoadJobsAsync();
            }
        }
        catch (HttpRequestException)
        {
            error = "Nepodařilo se načíst firmy.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnCompanyChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            selectedCompanyId = id;
            await LoadJobsAsync();
        }
    }

    private async Task LoadJobsAsync()
    {
        error = null;
        try
        {
            jobs = await
Http.GetFromJsonAsync<List<JobOfferManagementResponse>>($"api/companies/{selectedCompanyId}/jobs?offset=0&limit=100");
        }
        catch (HttpRequestException)
        {
            error = "Nepodařilo se načíst pracovní nabídky.";
        }
    }

    private async Task PublishAsync(Guid jobId)
    {
        busy = true;
        error = null;
        try
        {
            using var response = await Http.PostAsync($"api/companies/{selectedCompanyId}/jobs/{jobId}/publish", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadJobsAsync();
            }
            else if (response.StatusCode == HttpStatusCode.Conflict)
            {
                error = "Nabídku nelze publikovat (zkontrolujte, zda neuplynul termín uzávěrky).";
            }
            else
            {
                error = "Publikování nabídky se nezdařilo.";
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CloseAsync(Guid jobId)
    {
        busy = true;
        error = null;
        try
        {
            using var response = await Http.PostAsync($"api/companies/{selectedCompanyId}/jobs/{jobId}/close", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadJobsAsync();
            }
            else
            {
                error = "Uzavření nabídky se nezdařilo.";
            }
        }
        finally
        {
            busy = false;
        }
    }

    private static string GetWorkModeLabel(string mode) => mode switch
    {
        WorkModes.Onsite => "Na pracovišti",
        WorkModes.Hybrid => "Hybridní",
        WorkModes.Remote => "Remote",
        _ => mode
    };

    private static string GetEmploymentTypeLabel(string type) => type switch
    {
        EmploymentTypes.FullTime => "Plný úvazek",
        EmploymentTypes.PartTime => "Zkrácený úvazek",
        EmploymentTypes.Contract => "Kontrakt / IČO",
        EmploymentTypes.Internship => "Stáž",
        _ => type
    };

    private static string GetStatusLabel(string status) => status switch
    {
        JobOfferStatuses.Draft => "Koncept",
        JobOfferStatuses.Published => "Publikováno",
        JobOfferStatuses.Closed => "Uzavřeno",
        JobOfferStatuses.Archived => "Archivováno",
        _ => status
    };
}