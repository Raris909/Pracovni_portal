@page "/company/{CompanyId:guid}/jobs/new"
@page "/company/{CompanyId:guid}/jobs/edit/{JobId:guid}"
@using System.Net
@using Portal.Contracts.Auth
@using Portal.Contracts.Jobs
@inject Portal.Web.Services.AuthSession Session
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>@(IsEdit ? "Úprava pozice" : "Nová pracovní pozice")</PageTitle>

<h1>@(IsEdit ? "Úprava pracovní pozice" : "Vytvoření nové pracovní pozice")</h1>

@if (loading)
{
    <p>Načítání údajů…</p>
}
else
{
    @if (error is not null)
    {
        <p role="alert" style="color: red;">@error</p>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div>
            <label for="title">Název pozice</label>
            <InputText id="title" @bind-Value="model.Title" />
        </div>

        <div>
            <label for="work-mode">Režim práce</label>
            <InputSelect id="work-mode" @bind-Value="model.WorkMode">
                <option value="">-- Vyberte režim --</option>
                <option value="@WorkModes.Onsite">Na pracovišti (Onsite)</option>
                <option value="@WorkModes.Hybrid">Hybridní</option>
                <option value="@WorkModes.Remote">Remote</option>
            </InputSelect>
        </div>

        <div>
            <label for="employment-type">Typ úvazku</label>
            <InputSelect id="employment-type" @bind-Value="model.EmploymentType">
                <option value="">-- Vyberte úvazek --</option>
                <option value="@EmploymentTypes.FullTime">Plný úvazek</option>
                <option value="@EmploymentTypes.PartTime">Zkrácený úvazek</option>
                <option value="@EmploymentTypes.Contract">Kontrakt / IČO</option>
                <option value="@EmploymentTypes.Internship">Stáž</option>
            </InputSelect>
        </div>

        <div>
            <label for="location">Lokalita (Město / Adresa)</label>
            <InputText id="location" @bind-Value="model.Location" placeholder="např. Praha" />
        </div>

        <fieldset>
            <legend>Ohodnocení / Mzda (nepovinné)</legend>
            <div>
                <label for="salary-min">Minimální mzda</label>
                <InputNumber id="salary-min" @bind-Value="model.SalaryMin" />
            </div>

            <div>
                <label for="salary-max">Maximální mzda</label>
                <InputNumber id="salary-max" @bind-Value="model.SalaryMax" />
            </div>

            <div>
                <label for="salary-currency">Měna (3 velká písmena, např. CZK, EUR)</label>
                <InputText id="salary-currency" @bind-Value="salaryCurrencyInput" placeholder="CZK" />
            </div>

            <div>
                <label for="salary-period">Perioda</label>
                <InputSelect id="salary-period" @bind-Value="salaryPeriodInput">
                    <option value="">-- Bez periody --</option>
                    <option value="@SalaryPeriods.Month">Měsíčně</option>
                    <option value="@SalaryPeriods.Hour">Hodinově</option>
                    <option value="@SalaryPeriods.Year">Ročně</option>
                </InputSelect>
            </div>
        </fieldset>

        <div>
            <label for="deadline">Uzávěrka přihlášek</label>
            <InputDate id="deadline" @bind-Value="deadlineLocalDate" />
        </div>

        <div>
            <label for="description">Detailní popis pozice</label>
            <InputTextArea id="description" @bind-Value="model.Description" rows="6" />
        </div>

        <div>
            <label for="requirements">Požadavky na uchazeče</label>
            <InputTextArea id="requirements" @bind-Value="model.Requirements" rows="6" />
        </div>

        <div class="actions">
            <button type="submit" disabled="@saving">
                @(saving ? "Ukládám…" : "Uložit koncept")
            </button>
            <a class="btn-secondary" href="@($"company/{CompanyId}/jobs")">Zrušit</a>
        </div>

        <ValidationSummary />
    </EditForm>
}

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? JobId { get; set; }

    private JobOfferRequest model = new();
    private bool IsEdit => JobId.HasValue;
    private bool loading;
    private bool saving;
    private string? error;

    // Převede prázdný string na null, aby prošla validace JobOfferRequest.Validate()
    private string? salaryCurrencyInput
    {
        get => model.SalaryCurrency;
        set => model.SalaryCurrency = string.IsNullOrWhiteSpace(value) ? null : value.Trim().ToUpperInvariant();
    }

    private string? salaryPeriodInput
    {
        get => model.SalaryPeriod;
        set => model.SalaryPeriod = string.IsNullOrWhiteSpace(value) ? null : value;
    }

    private DateTime? deadlineLocalDate
    {
        get => model.ApplicationDeadline?.LocalDateTime;
        set => model.ApplicationDeadline = value.HasValue ? new DateTimeOffset(value.Value) : null;
    }

    protected override async Task OnInitializedAsync()
    {
        if (Session.User is null || Session.User.Role != UserRoles.Company)
        {
            Navigation.NavigateTo("login");
            return;
        }

        if (IsEdit)
        {
            loading = true;
            try
            {
                var response = await Http.GetFromJsonAsync<JobOfferManagementResponse>($"api/companies/{CompanyId}/jobs/{JobId}");
                if (response is not null)
                {
                    if (response.Status != JobOfferStatuses.Draft)
                    {
                        error = "Upravovat lze pouze nabídky ve stavu koncept (draft).";
                        return;
                    }

                    model = new JobOfferRequest
                    {
                        Title = response.Title,
                        Description = response.Description,
                        Requirements = response.Requirements,
                        Location = response.Location,
                        WorkMode = response.WorkMode,
                        EmploymentType = response.EmploymentType,
                        SalaryMin = response.SalaryMin,
                        SalaryMax = response.SalaryMax,
                        SalaryCurrency = response.SalaryCurrency,
                        SalaryPeriod = response.SalaryPeriod,
                        ApplicationDeadline = response.ApplicationDeadline
                    };
                }
            }
            catch (HttpRequestException)
            {
                error = "Nabídku práce se nepodařilo načíst.";
            }
            finally
            {
                loading = false;
            }
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        error = null;

        try
        {
            using var response = IsEdit
                ? await Http.PutAsJsonAsync($"api/companies/{CompanyId}/jobs/{JobId}", model)
                : await Http.PostAsJsonAsync($"api/companies/{CompanyId}/jobs", model);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo($"company/{CompanyId}/jobs");
            }
            else if (response.StatusCode == HttpStatusCode.Conflict)
            {
                error = "Upravovat lze pouze koncept nabídky.";
            }
            else
            {
                error = "Uložení pozice selhalo. Zkontrolujte všechna povinná pole a nastavení mzdy.";
            }
        }
        catch (HttpRequestException)
        {
            error = "Chyba při komunikaci se serverem.";
        }
        finally
        {
            saving = false;
        }
    }
}