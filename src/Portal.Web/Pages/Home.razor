@page "/"
@using Portal.Contracts.Jobs
@inject HttpClient Http

<PageTitle>Pracovní nabídky</PageTitle>
<h1>Pracovní nabídky</h1>
@if (error is not null)
{
    <p role="alert">@error</p>
}
else if (jobs is null)
{
    <p>Načítání nabídek…</p>
}
else if (jobs.Count == 0)
{
    <p>Zatím nejsou zveřejněné žádné pracovní nabídky.</p>
    @if (offset > 0)
    {
        <button @onclick="PreviousAsync">Předchozí</button>
    }
}
else
{
    @foreach (var job in jobs)
    {
        <article>
            <h2><a href="@($"jobs/{job.Id}")">@job.Title</a></h2>
            <p>
                <strong>@job.CompanyName</strong>
                @if (!string.IsNullOrWhiteSpace(job.Location))
                {
                    <span> · @job.Location</span>
                }
                <span> · @GetWorkModeLabel(job.WorkMode)</span>
            </p>
        </article>
    }
    <div class="actions">
        <button disabled="@(offset == 0 || loading)" @onclick="PreviousAsync">Předchozí</button>
        <button disabled="@(jobs.Count < PageSize || loading)" @onclick="NextAsync">Další</button>
    </div>
}

@code {
    private const int PageSize = 20;
    private List<JobOfferResponse>? jobs;
    private string? error;
    private int offset;
    private bool loading;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            jobs = await Http.GetFromJsonAsync<List<JobOfferResponse>>($"api/jobs?offset={offset}&limit={PageSize}");
        }
        catch (HttpRequestException)
        {
            error = "Nabídky se nepodařilo načíst. Zkuste stránku obnovit.";
        }
        finally { loading = false; }
    }

    private async Task PreviousAsync()
    {
        offset = Math.Max(0, offset - PageSize);
        await LoadAsync();
    }

    private async Task NextAsync()
    {
        offset += PageSize;
        await LoadAsync();
    }

    private static string GetWorkModeLabel(string mode) => mode switch
    {
        WorkModes.Onsite => "Na pracovišti",
        WorkModes.Hybrid => "Hybridní",
        WorkModes.Remote => "Remote",
        _ => mode
    };
}