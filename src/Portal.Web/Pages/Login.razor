@page "/login"
@using Portal.Contracts.Auth
@inject Portal.Web.Services.AuthSession Session
@inject NavigationManager Navigation

<PageTitle>Přihlášení</PageTitle>
<h1>Přihlášení</h1>
<EditForm Model="model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <label for="email">E-mail</label>
    <InputText id="email" type="email" autocomplete="username" @bind-Value="model.Email" />
    <label for="password">Heslo</label>
    <InputText id="password" type="password" autocomplete="current-password" @bind-Value="model.Password" />
    <button type="submit" disabled="@busy">Přihlásit se</button>
</EditForm>
@if (error is not null) { <p role="alert">@error</p> }

@code {
    private readonly LoginRequest model = new();
    private bool busy;
    private string? error;

    private async Task SubmitAsync()
    {
        busy = true;
        try
        {
            error = await Session.LoginAsync(model);
            if (error is null) Navigation.NavigateTo("account");
        }
        catch (HttpRequestException)
        {
            error = "Server není dostupný. Zkuste to později.";
        }
        finally { busy = false; }
    }
}
